{
  "name": "react-template",
  "description": "基于 React、TypeScript、Vite 与 shadcn/ui 的现代前端项目模板",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:prod": "vite build --mode production",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "prepare": "tsx ./scripts/print-environment.ts && husky",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/ --max-warnings 0",
    "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/ --max-warnings 0",
    "lint:staged": "lint-staged",
    "format": "prettier --write . --ignore-unknown --cache",
    "format:check": "prettier --check . --ignore-unknown --cache",
    "check-types": "tsc -b --pretty false",
    "check:dead-code": "knip --cache",
    "check:cycles": "knip --cycles --cache",
    "check-all": "pnpm lint && pnpm check-types && pnpm format:check && pnpm check:dead-code && pnpm check:cycles",
    "gen:icons": "tsx ./scripts/gen-icons.ts",
    "gen:api": "tsx ./scripts/gen-api.ts",
    "gen:lines": "tsx ./scripts/gen-lines.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.3",
    "@tanstack/react-router": "^1.170.18",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jotai": "^2.20.2",
    "lucide-react": "^1.25.0",
    "radix-ui": "^1.6.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.98.2",
    "@rolldown/plugin-babel": "^0.2.3",
    "@svgr/cli": "^8.1.0",
    "@svgr/core": "^8.1.0",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@tanstack/router-plugin": "^1.168.23",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.6.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^17.1.1",
    "prettier": "^3.8.4",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.1"
  },
  "packageManager": "pnpm@10.34.5+sha512.a4ee05f2f73658255bd6a89859c065a45c28a57daefae2c893a168ee2b73168c37b91e83e57ea67654ad03f03031746430e8bce38e362e042605fb8abc80192e",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
